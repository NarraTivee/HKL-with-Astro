---
---

<header class="header" id="header">
    <div class="header__container container container--hero">

        <!-- Логотип -->
        <div class="header__logo">
            <a href="/" class="header__logo-link">
                <h1>H&K Logistic</h1>
            </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="header__nav-desktop" aria-label="Основное меню">
            <ul class="header__nav-list">
                <li><a href="#services">УСЛУГИ</a></li>
                <li><a href="#about">О НАС</a></li>
                <li><a href="#workflow">КАК МЫ РАБОТАЕМ</a></li>
                <li><a href="#works">НАШИ РАБОТЫ</a></li>
                <li><a href="#contacts">КОНТАКТЫ</a></li>
            </ul>
        </nav>

        <!-- Бургер -->
        <button class="header__burger" aria-label="Открыть меню" id="burgerBtn">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>

<!-- Мобильное меню -->
<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu__header">
        <div class="mobile-menu__logo">H&K Logistic</div>
        <button class="mobile-menu__close" aria-label="Закрыть" id="closeBtn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <nav class="mobile-menu__nav">
        <ul class="mobile-menu__list">
            <li><a href="#services" class="mobile-menu__link">Услуги</a></li>
            <li><a href="#about" class="mobile-menu__link">О нас</a></li>
            <li><a href="#workflow" class="mobile-menu__link">Как мы работаем</a></li>
            <li><a href="#works" class="mobile-menu__link">Наши работы</a></li>
            <li><a href="#contacts" class="mobile-menu__link">Контакты</a></li>
        </ul>
    </nav>

    <div class="mobile-menu__footer">
        <p>Международные грузоперевозки</p>
    </div>
</div>

<style lang="scss">
  .header {
    position: relative;
    z-index: 1000;
    margin-bottom: 2rem;
    padding: 0 1rem;

    &__container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.5rem;
      background: rgba(15, 25, 40, 0.88);
      border-radius: 16px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }

    &__logo-link {
      text-decoration: none;
      h1 {
        margin: 0;
        font-size: clamp(1.3rem, 2.5vw, 1.8rem);
        color: $accent;
        letter-spacing: 0.5px;
        transition: color 0.3s ease;
      }
      &:hover h1 {
        color: #fff;
      }
    }

    &__nav-desktop {
      @media (max-width: $breakpoint-desktop) { display: none; }
    }

    &__nav-list {
      display: flex;
      gap: 0.8rem;
      margin: 0;
      padding: 0;
      list-style: none;

      a {
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: all 0.25s ease;

        &:hover {
          background: rgba(224, 167, 94, 0.15);
          color: white;
        }
      }
    }

    &__burger {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      flex-direction: column;
      gap: 5px;
      z-index: 10001;

      @media (max-width: $breakpoint-desktop) { display: flex; }

      span {
        width: 28px;
        height: 3px;
        background: white;
        border-radius: 2px;
        transition: all 0.3s ease;
      }

      &.active span:nth-child(1) { transform: rotate(45deg) translate(8px, 8px); }
      &.active span:nth-child(2) { opacity: 0; }
      &.active span:nth-child(3) { transform: rotate(-45deg) translate(7px, -7px); }
    }
  }

  // Overlay
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;

    &.active {
      opacity: 1;
      visibility: visible;
    }
  }

  // Мобильное меню
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: 320px;
    max-width: 85vw;
    height: 100vh;
    background: linear-gradient(
                    180deg,
                    rgba(15, 25, 40, 0.98) 0%,
                    rgba(13, 27, 42, 0.98) 100%
    );
    z-index: 9999;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;

    &.active {
      transform: translateX(0);
    }

    // Шапка меню
    &__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 1.5rem 1rem;
      border-bottom: 1px solid rgba(224, 167, 94, 0.15);
    }

    &__logo {
      font-size: 1.3rem;
      font-weight: 700;
      color: $accent;
      letter-spacing: 0.5px;
    }

    &__close {
      width: 40px;
      height: 40px;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 10px;
      color: rgba(255, 255, 255, 0.8);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;

      &:hover {
        background: rgba(224, 167, 94, 0.15);
        border-color: $accent;
        color: $accent;
      }

      svg {
        width: 20px;
        height: 20px;
      }
    }

    // Навигация
    &__nav {
      flex: 1;
      padding: 2rem 1.5rem;
      overflow-y: auto;
    }

    &__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    &__link {
      display: flex;
      align-items: center;
      padding: 1rem 1.2rem;
      font-size: 1rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      border-radius: 12px;
      background: transparent;
      border: 1px solid transparent;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;

      &::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 3px;
        background: $accent;
        transform: scaleY(0);
        transition: transform 0.3s ease;
      }

      &:hover {
        background: rgba(224, 167, 94, 0.08);
        border-color: rgba(224, 167, 94, 0.2);
        color: $accent;
        padding-left: 1.5rem;

        &::before {
          transform: scaleY(1);
        }
      }

      &:active {
        transform: scale(0.98);
      }
    }

    // Футер меню
    &__footer {
      padding: 1.5rem;
      border-top: 1px solid rgba(224, 167, 94, 0.15);

      p {
        margin: 0;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
        line-height: 1.5;
      }
    }
  }

  @media (max-width: $breakpoint-tablet) {
    .header {
      margin-bottom: 1.5rem;
      &__container {
        padding: 1rem;
        border-radius: 14px;
      }
    }
  }

  @media (max-width: $breakpoint-mobile) {
    .header {
      margin-bottom: 1.2rem;
      &__container { padding: 0.9rem; }
      .header__logo h1 { font-size: 1.35rem; }
    }

    .mobile-menu {
      width: 280px;

      &__header {
        padding: 1.2rem 1.2rem 0.8rem;
      }

      &__nav {
        padding: 1.5rem 1.2rem;
      }

      &__link {
        padding: 0.9rem 1rem;
        font-size: 0.95rem;
      }

      &__footer {
        padding: 1.2rem;
      }
    }
  }
</style>

<script>
    const burgerBtn = document.getElementById('burgerBtn');
    const closeBtn = document.getElementById('closeBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const overlay = document.getElementById('mobileOverlay');

    const openMenu = () => {
        mobileMenu?.classList.add('active');
        overlay?.classList.add('active');
        burgerBtn?.classList.add('active');
        document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
        mobileMenu?.classList.remove('active');
        overlay?.classList.remove('active');
        burgerBtn?.classList.remove('active');
        document.body.style.overflow = '';
    };

    burgerBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    overlay?.addEventListener('click', closeMenu);

    document.querySelectorAll('.mobile-menu__link').forEach(link => {
        link.addEventListener('click', closeMenu);
    });

    // Плавный скролл
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            const href = this.getAttribute('href');
            if (!href || href === '#') return;
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
                if (mobileMenu?.classList.contains('active')) closeMenu();
            }
        });
    });

    // Закрытие по ESC
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu?.classList.contains('active')) {
            closeMenu();
        }
    });
</script>