---
import { Mail, Phone } from 'lucide-astro'
import logoSvg from '../../assets/logo-hkl.svg'
---

<footer id='contacts' class='footer'>
	<div class='footer__inner container'>
		<div class='footer__main'>
			<!-- Бренд -->
			<div class='footer__brand'>
				<img
					src={logoSvg.src}
					alt='HK Logistic'
					class='footer__logo'
					width='80'
					height='80'
					loading='lazy'
				/>
				<p class='footer__tagline'>
					Международные грузоперевозки<br />
					<span>Надёжность • Скорость • Качество</span>
				</p>
			</div>

			<!-- Контакты -->
			<div class='footer__contacts'>
				<h3 class='footer__title'>Свяжитесь с нами</h3>

				<div class='footer__phones'>
					<a
						href='tel:+375333974210'
						class='footer__phone-link'
						aria-label='Позвонить +375 (33) 397-42-10'
					>
						<Phone size={18} />
						<div>
							<div class='footer__number'>+375 (33) 397 42 10</div>
							<div class='footer__hint'>Viber • Telegram • WhatsApp</div>
						</div>
					</a>

					<a
						href='tel:+79203044380'
						class='footer__phone-link'
						aria-label='Позвонить +7 (920) 304-43-80'
					>
						<Phone size={18} />
						<div>
							<div class='footer__number'>+7 (920) 304 43 80</div>
							<div class='footer__hint'>WhatsApp</div>
						</div>
					</a>

					<a
						href='tel:+48577010872'
						class='footer__phone-link'
						aria-label='Позвонить +48 (57) 701-08-72'
					>
						<Phone size={18} />
						<div class='footer__number'>+48 (57) 701 08 72</div>
					</a>

					<a
						href='tel:+375292896394'
						class='footer__phone-link'
						aria-label='Позвонить +375 (29) 289-63-94'
					>
						<Phone size={18} />
						<div>
							<div class='footer__number'>+375 (29) 289 63 94</div>
							<div class='footer__hint'>Viber • Telegram • WhatsApp</div>
						</div>
					</a>
				</div>
			</div>

			<!-- Email -->
			<div class='footer__email'>
				<a href='mailto:iphalburda@gmail.com' class='footer__email-link'>
					<Mail size={22} />
					<span>iphalburda@gmail.com</span>
				</a>
			</div>
		</div>

		<!-- Нижняя часть -->
		<div class='footer__bottom'>
			<p>© 2025–2026 HALABURDA & KRAVEL LOGISTIC</p>
			<p class='footer__rights'>Все права защищены</p>
		</div>
	</div>
</footer>

<style lang='scss'>
	.footer {
		margin-top: 6rem;
		padding-top: 4rem;
		position: relative;
		overflow: hidden;

		// Тонкая акцентная линия сверху (лёгкая, без градиента)
		&::before {
			content: '';
			position: absolute;
			top: 0;
			left: 10%;
			right: 10%;
			height: 1px;
			background: rgba(224, 167, 94, 0.25);
		}

		&__inner {
			padding: 0 2rem 2rem;
		}

		&__main {
			display: grid;
			grid-template-columns: 260px 1fr auto;
			gap: 3rem;
			padding-bottom: 2rem;
			margin-bottom: 2rem;
			border-bottom: 1px solid rgba(224, 167, 94, 0.15);

			@media (max-width: $breakpoint-desktop) {
				grid-template-columns: 1fr;
				text-align: center;
				gap: 2.5rem;
			}
		}

		&__brand {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1rem;
		}

		&__logo {
			width: 80px;
			filter: drop-shadow(0 4px 12px rgba(224, 167, 94, 0.15));
			transition: transform 0.3s ease;

			&:hover {
				transform: scale(1.05);
			}
		}

		&__tagline {
			margin: 0;
			font-size: 0.92rem;
			line-height: 1.5;
			color: #e8e6e3;
			text-align: center;

			span {
				display: block;
				margin-top: 0.5rem;
				font-size: 0.8rem;
				color: $accent;
				font-weight: 500;
				letter-spacing: 0.5px;
			}
		}

		&__title {
			margin: 0 0 1.2rem;
			font-size: 0.8rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 1.8px;
			color: $accent;
			opacity: 0.95;
		}

		&__phones {
			display: flex;
			flex-direction: column;
			gap: 0.9rem;
		}

		&__phone-link {
			display: flex;
			align-items: center;
			gap: 0.9rem;
			text-decoration: none;
			padding: 0.6rem 0;
			border-radius: 8px;
			transition: all 0.3s ease;
			color: inherit;

			&:hover {
				transform: translateX(6px);
				color: $accent;

				svg {
					opacity: 1;
				}
				.footer__number {
					color: $accent;
				}
			}

			svg {
				flex-shrink: 0;
				opacity: 0.8;
				transition: opacity 0.3s;
			}
		}

		&__number {
			font-size: 1.05rem;
			font-weight: 500;
			color: #f5f4f0;
			letter-spacing: 0.5px;
			transition: color 0.3s;
		}

		&__hint {
			font-size: 0.76rem;
			color: #aaa;
			margin-top: 0.15rem;
			letter-spacing: 0.4px;
		}

		&__email {
			@media (max-width: $breakpoint-desktop) {
				justify-self: center;
			}
		}

		&__email-link {
			display: inline-flex;
			align-items: center;
			gap: 0.8rem;
			font-size: 1.05rem;
			font-weight: 500;
			color: #f5f4f0;
			text-decoration: none;
			padding: 1rem 1.6rem;
			border-radius: 12px;
			background: rgba(224, 167, 94, 0.08);
			border: 1px solid rgba(224, 167, 94, 0.2);
			transition: all 0.4s ease;

			&:hover {
				background: rgba(224, 167, 94, 0.15);
				border-color: $accent;
				transform: translateY(-2px);
				box-shadow: 0 8px 20px rgba(224, 167, 94, 0.15);

				span::after {
					width: 100%;
				}
			}

			span {
				position: relative;

				&::after {
					content: '';
					position: absolute;
					bottom: -3px;
					left: 0;
					width: 0;
					height: 1.5px;
					background: $accent;
					transition: width 0.4s ease;
				}
			}

			svg {
				opacity: 0.9;
			}
		}

		&__bottom {
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
			gap: 1rem;
			font-size: 0.88rem;
			color: #999;

			@media (max-width: $breakpoint-mobile) {
				flex-direction: column;
				text-align: center;
			}
		}

		&__rights {
			font-size: 0.8rem;
			opacity: 0.8;
		}
	}

	@media (max-width: $breakpoint-desktop) {
		.footer__contacts {
			align-items: center;
			text-align: center;
		}

		.footer__phones {
			width: 100%;
			max-width: 340px;
			margin: 0 auto;
		}

		.footer__phone-link {
			justify-content: center;
		}
	}
</style>
